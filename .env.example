# ─────────────────────────────────────────────────────────
# KBTU Sustainable Campus Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Server port (must be unique across all projects on host) ──────────────────
# Default: 3010
# Change this if another service already uses 3010.
PORT=3010

# ── Public URL (used by React build for routing) ──────────────────────────────
# For subdomain deploy:  https://sustainability.kbtu.kz
# For local dev:         http://localhost:3010
PUBLIC_URL=http://localhost:3010

# ── Admin credentials ─────────────────────────────────────────────────────────
# This is used as the dashboard admin password (stored in localStorage on client).
# Also must match the password in google-apps-script/Code.gs (SHEET_PASSWORD).
REACT_APP_ADMIN_PASSWORD=kbtu2024

# ── Google Maps API Key (for interactive campus map page) ─────────────────────
# Get yours at: https://console.cloud.google.com
# Enable: Maps JavaScript API + Maps Static API
# Leave empty to skip the map page (it will show a setup screen instead).
REACT_APP_GMAPS_KEY=

# ── Google Sheets integration (optional, for live data sync) ─────────────────
# Paste the Web App URL after deploying google-apps-script/Code.gs.
# Leave empty to use localStorage only.
REACT_APP_SHEETS_API_URL=

# ── Build output directory (used by Docker / nginx) ──────────────────────────
# Do not change unless you update the Dockerfile as well.
BUILD_DIR=build
